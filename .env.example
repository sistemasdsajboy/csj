# Plantilla de variables de entorno.
#
# Copia este archivo como `.env` y completa los valores:
#     cp .env.example .env
#
# ADVERTENCIA
# Este archivo se sube al repositorio, que es PÚBLICO.
# Nunca escribas credenciales reales aquí. Solo en tu `.env`, que git ignora.
#
# REGLA DEL PROYECTO
# En desarrollo, NINGUNA de estas variables debe apuntar a producción.
# El sistema calcula calificaciones de funcionarios judiciales: escribir en la
# base real o enviar un correo real desde tu máquina tiene consecuencias sobre
# personas.

# ---------------------------------------------------------------------------
# Base de datos — MongoDB Atlas
# ---------------------------------------------------------------------------
# Usa un clúster M0 (gratuito) creado exclusivamente para desarrollo,
# con usuario y contraseña propios. NUNCA el clúster de producción.
DATABASE_URL="mongodb+srv://USUARIO:CLAVE@CLUSTER-DESARROLLO.mongodb.net/calificaciones?retryWrites=true&w=majority"

# ---------------------------------------------------------------------------
# Correo — Resend
# ---------------------------------------------------------------------------
# En desarrollo el envío está desactivado por código (src/lib/server/email.ts):
# el contenido del correo se imprime en la consola y no sale nada.
# Aun así, usa una clave de prueba y no la de producción.
RESEND_API_KEY="re_clave_de_prueba"

# ---------------------------------------------------------------------------
# SIERJU — Sistema de estadísticas de la Rama Judicial
# ---------------------------------------------------------------------------
# Solo consulta y descarga reportes, pero inicia sesión con credenciales
# institucionales reales. Los intentos repetidos pueden bloquear la cuenta.
# Déjalo vacío si no vas a trabajar en la descarga de estadísticas.
SIERJU_URL=""
SIERJU_USERNAME=""
SIERJU_PASSWORD=""

# ---------------------------------------------------------------------------
# Playwright
# ---------------------------------------------------------------------------
# Navegador remoto usado por el scraper de SIERJU.
# Vacío = se usa el navegador local instalado por Playwright.
PLAYWRIGHT_ENDPOINT=""
